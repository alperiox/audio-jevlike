.DS_Store
__pycache__/
*.pyc
.venv/
data/
cache/
checkpoints/
wandb/
.worktrees/
.superpowers/
.claude/worktrees/

# Model weights live on the Hugging Face Space, not in git history.
# space/model/bins.json IS tracked -- it is 151 bytes and the live demo
# refuses to start without it.
space/model/*.pt

# Agentic-harness working documents (specs, plans, ledgers). Kept on disk,
# not published: they are the scaffolding that produced the work, not the
# work. Note they remain in git HISTORY before this commit.
docs/superpowers/

# A global ~/.gitignore_global with *.txt silently excluded this, so the
# repo could not rebuild the Space while the Space itself worked (it was
# uploaded directly). Nothing errors in that state -- the file simply never
# appears in git status.
!space/requirements.txt
